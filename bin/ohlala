#!/bin/bash
# Oh là là: press-and-hold accent picker for Omarchy.
#
# keyd (running as root) calls this script through runuser when a letter is
# held. The script asks the kept-loaded de.gransoftware.ohlala overlay inside
# omarchy-shell to show the popup, and the overlay calls back with `type <char>`
# for the character that was picked.
#
#   ohlala setup        write /etc/keyd/default.conf for the letters in accents.conf
#   ohlala remove       remove that keyd config again
#   ohlala <letter>     show the popup (called by keyd)
#   ohlala type <char>  insert a character (called by the overlay)

set -uo pipefail

PLUGIN_ID="de.gransoftware.ohlala"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(dirname "$(dirname "$SELF")")"
KEYD_CONF="/etc/keyd/default.conf"
KEYD_MARKER="# Generated by 'ohlala setup'"
HOLD_MS=350

accents_file() {
  local user_conf="${XDG_CONFIG_HOME:-$HOME/.config}/ohlala/accents.conf"
  if [[ -f $user_conf ]]; then
    printf '%s' "$user_conf"
  else
    printf '%s' "$PLUGIN_DIR/accents.conf"
  fi
}

# Characters configured for a letter: an explicit line wins, otherwise an
# uppercase letter falls back to the uppercased lowercase line.
lookup() {
  local line
  line=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$(accents_file)" | tail -1)
  if [[ -z $line && $1 == [A-Z] ]]; then
    line=$(lookup "${1,,}")
    line="${line^^}"
  fi
  printf '%s' "$line"
}

require() {
  local missing=()
  for cmd in "$@"; do command -v "$cmd" >/dev/null || missing+=("$cmd"); done
  if (( ${#missing[@]} )); then
    echo "ohlala: missing ${missing[*]}. Install with: sudo pacman -S --needed keyd wtype wl-clipboard jq" >&2
    exit 1
  fi
}

# Refuse to overwrite a keyd config somebody else wrote.
keyd_conf_is_ours() {
  [[ ! -e $KEYD_CONF ]] || head -1 "$KEYD_CONF" | grep -qF "$KEYD_MARKER"
}

# keyd runs command(...) through a root shell before runuser drops privileges,
# so everything put into that line must be inert to the shell. Rather than
# quoting (keyd's own parser also splits on ',' and ')'), allow only plain
# path and user-name characters and refuse anything else.
safe_for_keyd() {
  [[ $1 =~ ^[A-Za-z0-9_./-]+$ ]]
}

setup() {
  (( EUID != 0 )) || { echo "ohlala: run setup as your own user, not with sudo; it asks for sudo itself." >&2; exit 1; }
  require keyd wtype wl-copy wl-paste jq
  local accents keys conf k prefix name combo
  accents=$(accents_file)
  keys=$(sed -n 's/^[[:space:]]*\([a-zA-Z]\)[[:space:]]*=.*/\1/p' "$accents" | tr 'A-Z' 'a-z' | sort -u | tr '\n' ' ')
  [[ -n $keys ]] || { echo "ohlala: no letters found in $accents" >&2; exit 1; }

  if ! keyd_conf_is_ours; then
    echo "ohlala: $KEYD_CONF already exists and was not written by ohlala." >&2
    echo "Move it away first (for example: sudo mv $KEYD_CONF $KEYD_CONF.bak), then run 'ohlala setup' again." >&2
    exit 1
  fi

  conf=$(mktemp)
  # Expand now: $conf is local and gone by the time the EXIT trap runs.
  # shellcheck disable=SC2064
  trap "rm -f '$conf'" EXIT
  local user
  user=$(id -un)
  if ! safe_for_keyd "$user" || ! safe_for_keyd "$SELF"; then
    echo "ohlala: keyd would run this line as root, so it only accepts letters, digits and _ . / - in it." >&2
    echo "  user:   $user" >&2
    echo "  helper: $SELF" >&2
    echo "Install the plugin under a plain path (the default ~/.config/omarchy/plugins works) and run setup again." >&2
    exit 1
  fi
  local cmd="command(runuser -u $user -- $SELF"
  {
    echo "$KEYD_MARKER from $accents. Do not edit by hand."
    echo "# Remove with 'ohlala remove'. Panic escape if the keyboard misbehaves: Backspace+Escape+Enter kills keyd."
    echo "# Bindings in a modifier layer drop that modifier, so every combo re-adds it explicitly."
    echo "[ids]"; echo "*"; echo; echo "[main]"
    for k in $keys; do echo "$k = timeout($k, $HOLD_MS, $cmd $k))"; done
    echo; echo "[shift]"
    for k in $keys; do echo "$k = timeout(S-$k, $HOLD_MS, $cmd ${k^^}))"; done
    for combo in control alt meta control+alt control+meta control+shift alt+meta alt+shift meta+shift \
                 control+alt+meta control+alt+shift control+meta+shift alt+meta+shift control+alt+meta+shift; do
      prefix=""
      for name in ${combo//+/ }; do
        case $name in control) prefix+="C-" ;; alt) prefix+="A-" ;; meta) prefix+="M-" ;; shift) prefix+="S-" ;; esac
      done
      echo; echo "[$combo]"
      for k in $keys; do echo "$k = $prefix$k"; done
    done
  } > "$conf"

  keyd check "$conf" >/dev/null || { keyd check "$conf"; exit 1; }
  if cmp -s "$conf" "$KEYD_CONF" && systemctl is-active --quiet keyd; then
    echo "Oh là là is already set up (letters: $keys)"
    return
  fi
  sudo install -Dm644 "$conf" "$KEYD_CONF" || exit 1
  # A restart, not `keyd reload`: keyd 2.6 segfaulted on reload here.
  sudo systemctl enable keyd && sudo systemctl restart keyd || exit 1
  echo "Oh là là is ready. Hold one of these letters: $keys"
}

remove() {
  if [[ ! -e $KEYD_CONF ]]; then
    echo "Nothing to remove: $KEYD_CONF does not exist."
    return
  fi
  keyd_conf_is_ours || { echo "ohlala: $KEYD_CONF was not written by ohlala, leaving it alone." >&2; exit 1; }
  sudo rm -f "$KEYD_CONF" && sudo systemctl restart keyd
  echo "Removed $KEYD_CONF. keyd is still installed; stop it with: sudo systemctl disable --now keyd"
}

# Insert the picked character into the window that regains focus. wtype has to
# swap in a temporary keymap for non-ASCII chars, which Chromium drops (and even
# wipes the omnibox text) right after refocus, so outside terminals we paste it
# via the clipboard instead and restore the previous clipboard afterwards.
insert_char() {
  local ch=$1 class type saved
  sleep 0.1
  class=$(hyprctl activewindow -j | jq -r '.class // ""')
  case ${class,,} in
    kitty|alacritty|foot|*ghostty*|*terminal*) wtype "$ch" -s 150; return ;;
  esac
  saved=$(mktemp)
  type=$(wl-paste -l 2>/dev/null | head -1)
  [[ -n $type ]] && wl-paste -n -t "$type" > "$saved" 2>/dev/null
  printf '%s' "$ch" | wl-copy
  sleep 0.05
  wtype -M ctrl v -m ctrl -s 150
  if [[ -n $type ]]; then wl-copy -t "$type" < "$saved"; else wl-copy --clear; fi
  rm -f "$saved"
}

# keyd starts us with a bare environment: borrow the live Hyprland session's.
import_session_env() {
  local hypr_pid kv
  hypr_pid=$(pgrep -u "$(id -u)" -x Hyprland | head -1)
  [[ -n $hypr_pid ]] || exit 1
  while IFS= read -r -d '' kv; do export "$kv"; done < "/proc/$hypr_pid/environ"
  export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
}

show_popup() {
  local key=$1 chars payload
  import_session_env
  exec 2>>"${XDG_RUNTIME_DIR:-/tmp}/ohlala.log"
  chars=$(lookup "$key")
  [[ -n $chars ]] || exit 0
  # The picker is a kept-loaded overlay inside the running omarchy-shell, so
  # summoning it is one IPC call instead of a Quickshell cold start. The overlay
  # ignores a summon while it is already open (letter still held).
  payload=$(jq -cn --arg key "$key" --arg chars "$chars" '{key: $key, chars: $chars}')
  exec "$OMARCHY_PATH/bin/omarchy-shell" -q shell summon "$PLUGIN_ID" "$payload"
}

case ${1:-} in
  setup) setup ;;
  remove) remove ;;
  type) [[ -n ${2:-} ]] && insert_char "$2" ;;
  [a-zA-Z]) show_popup "$1" ;;
  *) sed -n '2,12s/^# \{0,1\}//p' "$SELF"; exit 1 ;;
esac
